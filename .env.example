# ============================================================
# Career_AI Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# App
# ----------------------------------------------------------
APP_NAME="NextCareOn"
APP_VERSION="0.1.0"
DEBUG=false
ENVIRONMENT=development   # development | production | testing

# ----------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://postgres:postgresYOUR_PASSWORD@localhost:5432/NextCareOn

# Set to true in development to print every SQL statement to stdout
DB_ECHO=false

# Connection pool — tune for your server's RAM and expected concurrency
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ----------------------------------------------------------
# Redis
# ----------------------------------------------------------
# Format: redis://HOST:PORT/DB_NUMBER
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ----------------------------------------------------------
# JWT Authentication
# ----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-real-secret-key-before-deploying

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------
# OpenAI / AI Engine
# ----------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4

# ----------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# ----------------------------------------------------------
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
