# ============================================================
# Nextcareon Backend — .env.example
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
# ============================================================


# ── App ──────────────────────────────────────────────────────
APP_NAME=Nextcareon
APP_VERSION=1.0.0
APP_ENV=development                          # development | staging | production
DEBUG=True                                   # Set False in production
SECRET_KEY=your-super-secret-key-change-me  # Generate: openssl rand -hex 32
ALLOWED_HOSTS=["http://localhost:3000","http://localhost:5173"]
API_PREFIX=/api/v1


# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nextcareon_user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=nextcareon_db

# Assembled automatically by app/core/config.py — do not change format
DATABASE_URL=postgresql+asyncpg://nextcareon_user:your-postgres-password@localhost:5432/nextcareon_db

# Sync URL used by Alembic migrations only
DATABASE_URL_SYNC=postgresql+psycopg2://nextcareon_user:your-postgres-password@localhost:5432/nextcareon_db


# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                              # Leave empty for local dev (no auth)
REDIS_DB=0                                  # DB index (0-15)
REDIS_URL=redis://localhost:6379/0          # Assembled URL for ARQ worker

# Cache TTL settings (seconds)
CACHE_TTL_MARKET_DATA=3600                  # 1 hour  — market intelligence
CACHE_TTL_LEADERBOARD=300                   # 5 mins  — leaderboard
CACHE_TTL_CAREER_SCORE=900                  # 15 mins — career score
CACHE_TTL_QUIZ_SESSION=1800                 # 30 mins — quiz in-progress


# ── JWT Authentication ────────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-key-change-me  # Generate: openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60            # 1 hour
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30             # 30 days


# ── OpenAI Chat Settings ─────────────────────────────────────
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_CHAT_MAX_TOKENS=1024

# ── OpenAI Embeddings for RAG ──────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536


# ── pgvector RAG settings ─────────────────────────────────────
RAG_CHUNK_SIZE=512                           # Tokens per chunk
RAG_CHUNK_OVERLAP=64                         # Overlap between chunks
RAG_TOP_K=5                                  # Top K chunks retrieved per query


# ── File Storage (AWS S3 or compatible) ──────────────────────
STORAGE_BACKEND=local                        # local | s3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=nextcareon-media
AWS_S3_URL=https://nextcareon-media.s3.ap-southeast-1.amazonaws.com

# Local storage fallback (used when STORAGE_BACKEND=local)
LOCAL_MEDIA_DIR=./media
LOCAL_MEDIA_URL=http://localhost:8000/media


# ── Text-to-Speech (Phase 2) ─────────────────────────────────
TTS_BACKEND=gtts                             # gtts | azure
TTS_DEFAULT_LANG=en

# Azure TTS (only if TTS_BACKEND=azure)
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=southeastasia


# ── Certificate Generation (Phase 2) ─────────────────────────
CERTIFICATE_TEMPLATE_DIR=./app/modules/certificates/templates
CERTIFICATE_FONT_DIR=./app/modules/certificates/fonts
CERTIFICATE_ISSUER_NAME=Nextcareon
CERTIFICATE_SIGNATURE_NAME=Nextcareon Team


# ── Gamification Settings (Phase 5) ──────────────────────────
COIN_LESSON_COMPLETE=10
COIN_QUIZ_PASS=25
COIN_ASSIGNMENT_COMPLETE=100
COIN_PROJECT_COMPLETE=300
COIN_COURSE_COMPLETE=500

LEADERBOARD_TOP_N=50                         # How many users shown on leaderboard


# ── Career Score Weights (Phase 4) ───────────────────────────
SCORE_WEIGHT_COURSE_COMPLETION=15            # %
SCORE_WEIGHT_QUIZ_PERFORMANCE=15            # %
SCORE_WEIGHT_PROJECT_QUALITY=30             # %
SCORE_WEIGHT_PORTFOLIO_STRENGTH=20          # %
SCORE_WEIGHT_MOCK_INTERVIEW=20              # %


# ── Rate Limiting (Phase 7) ───────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute               # General API endpoints
RATE_LIMIT_AUTH=10/minute                   # Login / signup
RATE_LIMIT_AI=20/minute                     # AI assistant endpoints
RATE_LIMIT_UPLOAD=5/minute                  # File upload endpoints


# ── Background Worker (ARQ) ───────────────────────────────────
WORKER_CONCURRENCY=10                        # Max concurrent background jobs
WORKER_JOB_TIMEOUT=300                       # Seconds before job times out
WORKER_RETRY_JOBS=3                          # Retry failed jobs N times


# ── Logging & Monitoring (Phase 7) ───────────────────────────
LOG_LEVEL=INFO                               # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                              # json (prod) | console (dev)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_TRACES_SAMPLE_RATE=0.1               # 10% of transactions traced


# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["*"]


# ── Admin ─────────────────────────────────────────────────────
FIRST_ADMIN_EMAIL=admin@nextcareon.com
FIRST_ADMIN_PASSWORD=change-me-immediately   # Changed on first login
FIRST_ADMIN_NAME=Super Admin


# ── Email (future: notifications) ────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@nextcareon.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM_NAME=Nextcareon
SMTP_TLS=True
